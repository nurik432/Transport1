DATABASE_URL=postgres://transport:transport@localhost:5433/transport
SESSION_SECRET=change-me-to-a-long-random-string

# Опционально. В Docker используются docker-compose.yml для подстановки
# значений в контейнеры (DATABASE_URL там переопределён на адрес сервиса db).
# ROUTING_URL=https://router.project-osrm.org
# Поиск места по названию в админке (Nominatim-совместимый сервис).
# Публичный сервер — не больше одного запроса в секунду, для регулярной
# работы поднимите свой инстанс.
# GEOCODER_URL=https://nominatim.openstreetmap.org
# Пешеходные маршруты для пассажира («Как дойти до остановки»), OSRM с профилем foot
# WALK_ROUTING_URL=https://routing.openstreetmap.de/routed-foot
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
# Публичный адрес приложения для ссылок в печатных QR табеля; без него берётся адрес запроса
# APP_URL=https://transport.example.com

# Секрет для cron-эндпоинта напоминаний табеля (/api/v1/cron/attendance-reminders).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# CRON_SECRET=
# Куда стучится cron, если APP_URL не подходит (например, http://localhost:3000)
# CRON_TARGET_URL=
