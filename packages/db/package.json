{
  "name": "@transport/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./routing": "./src/routing.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "bundle:migrate": "esbuild src/migrate.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/migrate.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "seed": "tsx src/seed.ts",
    "reset": "tsx src/reset.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "geometry": "tsx src/geometry.ts"
  },
  "dependencies": {
    "@transport/domain": "workspace:*",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.0",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}